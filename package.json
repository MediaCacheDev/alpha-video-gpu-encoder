{
  "name": "alpha-video-gpu-encoder",
  "version": "1.0.0",
  "description": "Encode PNG sequences and videos into ASTC texture arrays in KTX2 files, with premultiplied alpha, zstd and seek points, for the alpha-video-gpu player.",
  "bin": {
    "texenc": "./texenc.js",
    "texenc-stream": "./texenc-stream.js"
  },
  "files": [
    "texenc.js",
    "texenc-stream.js",
    "tools.js",
    "zstd-level.js",
    "ktx2-keys.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ktx2",
    "astc",
    "astcenc",
    "toktx",
    "ktx-software",
    "texture-compression",
    "texture-array",
    "gpu-texture",
    "zstd",
    "alpha",
    "transparency",
    "transparent-video",
    "premultiplied-alpha",
    "animation",
    "ffmpeg",
    "encoder",
    "cli",
    "alpha-video-gpu"
  ],
  "author": "Daniel Kasprowicz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MediaCacheDev/alpha-video-gpu-encoder.git"
  },
  "bugs": {
    "url": "https://github.com/MediaCacheDev/alpha-video-gpu-encoder/issues"
  },
  "homepage": "https://www.alpha-video.dev",
  "dependencies": {
    "commander": "^14.0.2",
    "sharp": "^0.34.5"
  }
}
